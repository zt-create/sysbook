<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.org.example.mapper.SysUserMapper">
    <!-- 登录 -->
    <select id="login" parameterType="SysUser" resultType="SysUser">
        select * from sys_user where username=#{username} and password=#{password}
    </select>

    <!-- 注册 -->
    <insert id="register" parameterType="SysUser">
        insert into sys_user(username,password,role) values (#{username},#{password},'student')
    </insert>

    <!-- 查询所有用户 -->
    <select id="list" resultType="SysUser">
        select * from sys_user
    </select>

    <!-- 根据ID查询用户 -->
    <select id="getById" resultType="SysUser">
        select * from sys_user where id=#{id}
    </select>

    <!-- 逻辑删除 -->
    <update id="delete">
        update sys_user set deleted=1 where id=#{id}
    </update>

    <!-- 修改用户信息 -->
    <update id="updateUser" parameterType="SysUser">
        update sys_user
        set username = #{username},
            password = #{password},
            nickname = #{nickname},
            phone = #{phone},
            head_img = #{headImg},
            role = #{role}
        where id = #{id}
    </update>
</mapper>