<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.org.example.mapper.BookBorrowMapper">
    <select id="list" resultType="BookBorrow">
        select  * from book_borrow
    </select>
    <insert id="add" parameterType="BookBorrow">
        insert into book_borrow(user_id,book_id) values (#{userId},#{bookId})
    </insert>
    <update id="returnBook">
        update book_borrow set return_time=now(),status='已归还' where id=#{id}
    </update>
    <select id="getById" resultType="BookBorrow">
        select * from book_borrow where id=#{id}
    </select>
</mapper>